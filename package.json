{
  "name": "setup-love",
  "version": "1.0.8",
  "description": "Set up your GitHub Actions workflow with LÖVE",
  "author": "Mark <mark@remarkablemark.org>",
  "main": "src/index.ts",
  "scripts": {
    "build": "ncc build --minify",
    "build:watch": "tsc --watch",
    "clean": "rm -rf coverage dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:ci": "CI=true vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.3",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "private": true,
  "license": "MIT"
}
